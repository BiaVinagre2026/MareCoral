# Porta local isolada para o ambiente de desenvolvimento.
MARE_CORAL_WEB_PORT=4310

# Porta local isolada para o container de produção.
MARE_CORAL_PROD_PORT=4312

# URL completa do WhatsApp Business. Exemplo:
# VITE_WHATSAPP_URL=https://wa.me/5521999999999?text=Quero%20entrar%20na%20lista%20VIP
VITE_WHATSAPP_URL=

# URLs das páginas sociais existentes que serão renomeadas para Maré Coral.
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=

# Domínio próprio definitivo, usado nos catálogos das redes sociais.
VITE_SITE_URL=https://marecoral.com.br
CATALOG_SITE_URL=https://marecoral.com.br

# Backend white-label Meu Mostruário. O navegador usa caminhos relativos e o
# proxy encaminha tudo sem disputar novas portas no Windows.
VITE_MOSTRUARIO_API_URL=/api/v1
VITE_MOSTRUARIO_TENANT=mare-coral
VITE_MOSTRUARIO_CATALOG_TOKEN=
VITE_ALLOW_DEMO_CATALOG=true
MOSTRUARIO_PROXY_TARGET=http://host.docker.internal:8000
MOSTRUARIO_BACKEND_URL=http://host.docker.internal:8000

# Ative somente quando o catálogo autorizado e o gateway do tenant estiverem prontos.
VITE_CHECKOUT_ENABLED=false

# IDs serão adicionados após criação/configuração no Meta Business e TikTok Business.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
